index 0000000..ccca616
--- /dev/null
+++ b/libraries/dictionary_learning/trainers/dual_sae.py
@@ -0,0 +1,472 @@
+"""
+DualSAE as a SAE-TM `dictionary_learning` dictionary/trainer.
+
+NOTE: the topic-modeling pipeline shipped with this repository does NOT use this class. Its SAEs
+are trained by the repository's `vision/` trainers and loaded through `interpret_sae.py --old-impl`
+(old_sae_adapter.py). This module is kept only because `interpret_sae.py` imports it at module
+level; it is an independent re-implementation and was not used to produce any reported run.
+
+DualSAE wraps a standard SAE Sparse Branch (whose sparsity rule S is swappable:
+topk / batch_topk / jump_relu) with a Residual Branch that models the residual:
+
+    z   = S(ReLU(W_E (x - b_dec)))          # sparse code  (what topic modeling uses)
+    xM  = W_D z + b_dec                       # Sparse Branch reconstruction
+    r   = x - xM                              # residual
+    r̂   = poly(r)                             # Residual Branch output (1 hidden layer, width 512, GELU)
+    x̂   = xM + r̂                              # full reconstruction
+
+  1. Decorrelation penalty  L_dcor = mean_active( (r̂ @ W_D)^2 )  (coef 0.01, ACTIVE latents only).
+  2. Two-stage training: a warm-up phase trains the Sparse Branch alone (Residual Branch frozen,
+     no decorrelation); then both branches train jointly with the decorrelation penalty.
+
+`encode()` returns ONLY the sparse code z.
+"""
+
+import math
+import torch as t
+import torch.nn as nn
+import torch.nn.functional as F
+import torch.autograd as autograd
+from collections import namedtuple
+from typing import Optional
+
+from ..dictionary import Dictionary
+from ..trainers.trainer import (
+    SAETrainer,
+    get_lr_schedule,
+    set_decoder_norm_to_unit_norm,
+    remove_gradient_parallel_to_decoder_directions,
+)
+
+
+@t.no_grad()
+def geometric_median(points: t.Tensor, max_iter: int = 100, tol: float = 1e-5) -> t.Tensor:
+    """Geometric median for b_dec init (same practice as TopK/BatchTopK trainers)."""
+    guess = points.mean(dim=0)
+    prev = t.zeros_like(guess)
+    weights = t.ones(len(points), device=points.device)
+    for _ in range(max_iter):
+        prev = guess
+        weights = 1.0 / t.norm(points - guess, dim=1).clamp_min(1e-8)
+        weights /= weights.sum()
+        guess = (weights.unsqueeze(1) * points).sum(dim=0)
+        if t.norm(guess - prev) < tol:
+            break
+    return guess
+
+
+# ── JumpReLU primitives (log-threshold form) ──────
+class _RectangleFunction(autograd.Function):
+    @staticmethod
+    def forward(ctx, x):
+        ctx.save_for_backward(x)
+        return ((x > -0.5) & (x < 0.5)).float()
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        (x,) = ctx.saved_tensors
+        g = grad_output.clone()
+        g[(x <= -0.5) | (x >= 0.5)] = 0
+        return g
+
+
+class _JumpReLUFunction(autograd.Function):
+    """y = x · 1[x > exp(log_threshold)], with straight-through threshold gradient."""
+    @staticmethod
+    def forward(ctx, x, log_threshold, bandwidth):
+        ctx.save_for_backward(x, log_threshold, t.tensor(bandwidth))
+        threshold = t.exp(log_threshold)
+        return x * (x > threshold).float()
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        x, log_threshold, bw = ctx.saved_tensors
+        bandwidth = bw.item()
+        threshold = t.exp(log_threshold)
+        x_grad = (x > threshold).float() * grad_output
+        thr_grad = (
+            -(threshold / bandwidth)
+            * _RectangleFunction.apply((x - threshold) / bandwidth)
+            * grad_output
+        )
+        return x_grad, thr_grad, None
+
+
+class _StepFunction(autograd.Function):
+    """1[x > exp(log_threshold)] used to get a differentiable L0 (for jump_relu penalty)."""
+    @staticmethod
+    def forward(ctx, x, log_threshold, bandwidth):
+        ctx.save_for_backward(x, log_threshold, t.tensor(bandwidth))
+        threshold = t.exp(log_threshold)
+        return (x > threshold).float()
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        x, log_threshold, bw = ctx.saved_tensors
+        bandwidth = bw.item()
+        threshold = t.exp(log_threshold)
+        thr_grad = (
+            -(1.0 / bandwidth)
+            * _RectangleFunction.apply((x - threshold) / bandwidth)
+            * grad_output
+        )
+        return t.zeros_like(x), thr_grad, None
+
+
+VALID_SPARSITY_MODES = ("topk", "batch_topk", "jump_relu")
+
+
+class DualSAE(Dictionary, nn.Module):
+    """Dual-branch SAE with a swappable mono sparsity rule.
+
+    Args:
+        activation_dim : input/output dim D
+        dict_size      : number of mono latents F
+        k              : top-k (topk / batch_topk modes)
+        sparsity_mode  : "topk" | "batch_topk" | "jump_relu"
+        poly_hidden    : poly MLP hidden width (paper: 512)
+        bandwidth      : JumpReLU straight-through bandwidth (jump_relu mode)
+    """
+
+    def __init__(
+        self,
+        activation_dim: int,
+        dict_size: int,
+        k: int,
+        sparsity_mode: str = "topk",
+        poly_hidden: int = 512,
+        bandwidth: float = 1e-3,
+        jump_init_threshold: float = 1e-3,
+    ):
+        super().__init__()
+        assert sparsity_mode in VALID_SPARSITY_MODES, f"bad sparsity_mode {sparsity_mode}"
+        self.activation_dim = activation_dim
+        self.dict_size = dict_size
+        self.sparsity_mode = sparsity_mode
+        self.poly_hidden = poly_hidden
+        self.bandwidth = bandwidth
+
+        # k persisted in state_dict so from_pretrained needs no side metadata.
+        self.register_buffer("k", t.tensor(int(k), dtype=t.int))
+
+        # Mono branch: unit-norm decoder columns (re-enforced each step), tied-init encoder.
+        self.decoder = nn.Linear(dict_size, activation_dim, bias=False)
+        self.decoder.weight.data = set_decoder_norm_to_unit_norm(
+            self.decoder.weight, activation_dim, dict_size
+        )
+        self.encoder = nn.Linear(activation_dim, dict_size)
+        self.encoder.weight.data = self.decoder.weight.T.clone()
+        self.encoder.bias.data.zero_()
+        self.b_dec = nn.Parameter(t.zeros(activation_dim))
+
+        # JumpReLU per-feature learnable threshold (only for jump_relu mode).
+        # IMPORTANT: init threshold = exp(log_threshold) to a SMALL value (0.001), not 1.0.
+        # Inputs here are unit-norm, so post-ReLU activations are well below 1.0; a threshold
+        # of 1.0 (log_threshold=0) zeros everything, leaving the encoder with no gradient
+        # (and the rectangle window for the threshold gradient also misses). Starting
+        # permissive lets features fire; the L0 penalty then raises thresholds.
+        self.jump_log_threshold = (
+            nn.Parameter(t.full((dict_size,), math.log(jump_init_threshold)))
+            if sparsity_mode == "jump_relu" else None
+        )
+
+        # Poly branch: one hidden layer of width `poly_hidden` + GELU (paper).
+        self.poly = nn.Sequential(
+            nn.Linear(activation_dim, poly_hidden),
+            nn.GELU(),
+            nn.Linear(poly_hidden, activation_dim),
+        )
+
+    # ── Dictionary interface ────────────────────────────────────────────────────
+    def pre_acts(self, x: t.Tensor) -> t.Tensor:
+        """Post-ReLU, pre-sparsify activations (used for AuxK / JumpReLU L0)."""
+        return F.relu(self.encoder(x - self.b_dec))
+
+    def _sparsify(self, post_relu: t.Tensor) -> t.Tensor:
+        """Apply the mono sparsity rule to post-ReLU activations → sparse code z."""
+        if self.sparsity_mode == "topk":
+            k = int(self.k.item())
+            top = post_relu.topk(k, sorted=False, dim=-1)
+            return t.zeros_like(post_relu).scatter_(-1, top.indices, top.values)
+        if self.sparsity_mode == "batch_topk":
+            # Keep exactly k·B entries across the whole batch (by value).
+            k = int(self.k.item())
+            B = post_relu.size(0)
+            flat = post_relu.flatten()
+            top = flat.topk(min(k * B, flat.numel()), sorted=False)
+            return (
+                t.zeros_like(flat).scatter_(-1, top.indices, top.values).reshape(post_relu.shape)
+            )
+        # jump_relu
+        return _JumpReLUFunction.apply(post_relu, self.jump_log_threshold, self.bandwidth)
+
+    def encode(self, x: t.Tensor, return_pre: bool = False):
+        """Sparse MONO code z (B, dict_size) — the interpretable code topic modeling uses."""
+        post_relu = self.pre_acts(x)
+        z = self._sparsify(post_relu)
+        if return_pre:
+            return z, post_relu
+        return z
+
+    def decode(self, z: t.Tensor) -> t.Tensor:
+        return self.decoder(z) + self.b_dec
+
+    def forward(self, x: t.Tensor, output_features: bool = False):
+        z = self.encode(x)
+        xM = self.decode(z)
+        r_hat = self.poly(x - xM)
+        x_hat = xM + r_hat
+        return (x_hat, z) if output_features else x_hat
+
+    def scale_biases(self, scale: float):
+        self.encoder.bias.data *= scale
+        self.b_dec.data *= scale
+        if self.jump_log_threshold is not None:
+            # threshold = exp(log_threshold); scaling threshold by `scale` shifts the log.
+            self.jump_log_threshold.data += math.log(scale)
+
+    @classmethod
+    def from_pretrained(
+        cls,
+        path: str,
+        sparsity_mode: str = "topk",
+        k: Optional[int] = None,
+        poly_hidden: Optional[int] = None,
+        bandwidth: float = 1e-3,
+        device=None,
+        **kwargs,
+    ) -> "DualSAE":
+        sd = t.load(path, map_location="cpu")
+        dict_size, activation_dim = sd["encoder.weight"].shape
+        if k is None:
+            k = int(sd["k"].item())
+        if poly_hidden is None:
+            poly_hidden = sd["poly.0.weight"].shape[0]
+        # Infer jump_relu from the presence of the threshold param if not specified explicitly.
+        if "jump_log_threshold" in sd and sparsity_mode != "jump_relu":
+            sparsity_mode = "jump_relu"
+        ae = cls(activation_dim, dict_size, k, sparsity_mode, poly_hidden, bandwidth)
+        ae.load_state_dict(sd)
+        if device is not None:
+            ae.to(device)
+        return ae
+
+
+class DualSAETrainer(SAETrainer):
+    """Two-stage DualSAE trainer (mono warm-up → joint + decorrelation).
+
+    Required: steps, activation_dim, dict_size, k, layer, lm_name.
+    Paper-faithful optionals: sparsity_mode, poly_hidden=512, decorr_coef=0.01,
+    dual_warmup_steps=2500, auxk_alpha=1/32, sparsity_penalty=1e-4 (jump_relu L0),
+    bandwidth=1e-3, lr=1e-4, eps=6.25e-10, warmup_steps, decay_start.
+    """
+
+    def __init__(
+        self,
+        steps: int,
+        activation_dim: int,
+        dict_size: int,
+        k: int,
+        layer: int,
+        lm_name: str,
+        sparsity_mode: str = "topk",
+        dict_class: type = DualSAE,
+        poly_hidden: int = 512,
+        decorr_coef: float = 0.01,
+        dual_warmup_steps: int = 2500,
+        auxk_alpha: float = 1 / 32,
+        sparsity_penalty: float = 1e-4,
+        bandwidth: float = 1e-3,
+        lr: float = 1e-4,
+        eps: float = 6.25e-10,
+        warmup_steps: int = 1000,
+        decay_start: Optional[int] = None,
+        seed: Optional[int] = None,
+        device: Optional[str] = None,
+        wandb_name: str = "DualSAE",
+        submodule_name: Optional[str] = None,
+    ):
+        super().__init__(seed)
+        assert layer is not None and lm_name is not None
+        assert sparsity_mode in VALID_SPARSITY_MODES
+        self.layer = layer
+        self.lm_name = lm_name
+        self.submodule_name = submodule_name
+        self.wandb_name = wandb_name
+        self.steps = steps
+        self.decay_start = decay_start
+        self.warmup_steps = warmup_steps
+        self.k = k
+        self.sparsity_mode = sparsity_mode
+        self.decorr_coef = decorr_coef
+        self.dual_warmup_steps = dual_warmup_steps
+        self.auxk_alpha = auxk_alpha
+        self.sparsity_penalty = sparsity_penalty
+
+        if seed is not None:
+            t.manual_seed(seed)
+            t.cuda.manual_seed_all(seed)
+
+        self.ae = dict_class(activation_dim, dict_size, k, sparsity_mode, poly_hidden, bandwidth)
+
+        self.device = device or ("cuda" if t.cuda.is_available() else "cpu")
+        self.ae.to(self.device)
+        self.lr = lr
+
+        # AuxK dead-feature revival (topk/batch_topk), mirroring BatchTopKTrainer.
+        self.dead_feature_threshold = 10_000_000
+        self.top_k_aux = activation_dim // 2
+        self.num_tokens_since_fired = t.zeros(dict_size, dtype=t.long, device=self.device)
+        self.logging_parameters = ["effective_l0", "dead_features", "in_warmup"]
+        self.effective_l0 = -1
+        self.dead_features = -1
+        self.in_warmup = True
+
+        # Adam with the paper's epsilon.
+        self.optimizer = t.optim.Adam(self.ae.parameters(), lr=lr, betas=(0.9, 0.999), eps=eps)
+        lr_fn = get_lr_schedule(steps, warmup_steps, decay_start=decay_start)
+        self.scheduler = t.optim.lr_scheduler.LambdaLR(self.optimizer, lr_lambda=lr_fn)
+
+    # ── loss components ──────────────────────────────────────────────────────────
+    def _decorr_loss(self, r_hat: t.Tensor, z: t.Tensor) -> t.Tensor:
+        """Decorrelation: penalize r̂'s overlap with ACTIVE mono-decoder columns.
+
+        decoder.weight is (D, F) for nn.Linear(F, D), so r̂ @ decoder.weight is (B, F):
+        one overlap per latent. Mask to active latents and normalize by n_active.
+        """
+        overlap = r_hat @ self.ae.decoder.weight                  # (B, F)
+        active = (z != 0).float()
+        overlap = overlap * active
+        n_active = active.sum(dim=1, keepdim=True).clamp_min(1.0)
+        return (overlap.pow(2).sum(dim=1, keepdim=True) / n_active).mean()
+
+    def _auxk_loss(self, residual_BD: t.Tensor, post_relu_BF: t.Tensor) -> t.Tensor:
+        """Revive dead mono latents to reconstruct the mono residual (OpenAI/BatchTopK form)."""
+        dead = self.num_tokens_since_fired >= self.dead_feature_threshold
+        self.dead_features = int(dead.sum())
+        if dead.sum() == 0:
+            return t.tensor(0.0, dtype=residual_BD.dtype, device=residual_BD.device)
+        k_aux = min(self.top_k_aux, int(dead.sum()))
+        auxk_latents = t.where(dead[None], post_relu_BF, -t.inf)
+        vals, idx = auxk_latents.topk(k_aux, sorted=False)
+        buf = t.zeros_like(post_relu_BF).scatter_(-1, idx, vals)
+        recon_aux = self.ae.decoder(buf)                          # no bias (matches baseline)
+        l2_aux = (residual_BD.float() - recon_aux.float()).pow(2).sum(dim=-1).mean()
+        mu = residual_BD.mean(dim=0)[None, :].broadcast_to(residual_BD.shape)
+        denom = (residual_BD.float() - mu.float()).pow(2).sum(dim=-1).mean()
+        return (l2_aux / denom).nan_to_num(0.0)
+
+    def _jump_l0_penalty(self, post_relu_BF: t.Tensor) -> t.Tensor:
+        """Differentiable L0 penalty for jump_relu mode (sparsity_penalty · mean L0)."""
+        l0 = _StepFunction.apply(
+            post_relu_BF, self.ae.jump_log_threshold, self.ae.bandwidth
+        ).sum(dim=-1).mean()
+        return self.sparsity_penalty * l0
+
+    def loss(self, x: t.Tensor, step: int = None, logging: bool = False):
+        in_warmup = step is not None and step < self.dual_warmup_steps
+        self.in_warmup = bool(in_warmup)
+
+        z, post_relu = self.ae.encode(x, return_pre=True)        # mono code + pre-sparsify acts
+        xM = self.ae.decode(z)
+
+        if in_warmup:
+            # Phase 1: mono branch alone learns to reconstruct (poly frozen in update()).
+            x_hat = xM
+            decorr = t.tensor(0.0, device=x.device)
+            r_hat = None
+        else:
+            # Phase 2: joint reconstruction + decorrelation.
+            r_hat = self.ae.poly(x - xM)
+            x_hat = xM + r_hat
+            decorr = self.decorr_coef * self._decorr_loss(r_hat, z)
+
+        l2_loss = (x - x_hat).pow(2).sum(dim=-1).mean()
+
+        # Dead-feature bookkeeping on the mono code.
+        did_fire = (z != 0).any(dim=0)
+        self.num_tokens_since_fired += x.size(0)
+        self.num_tokens_since_fired[did_fire] = 0
+        self.effective_l0 = float((z != 0).float().sum(dim=-1).mean().item())
+
+        # AuxK on the MONO residual (revives dead latents to capture mono-missed signal).
+        auxk = (
+            self._auxk_loss((x - xM).detach(), post_relu)
+            if self.auxk_alpha > 0 and self.sparsity_mode in ("topk", "batch_topk")
+            else t.tensor(0.0, device=x.device)
+        )
+        # JumpReLU explicit L0 penalty (its sparsity is not from a hard top-k).
+        jump_pen = (
+            self._jump_l0_penalty(post_relu)
+            if self.sparsity_mode == "jump_relu"
+            else t.tensor(0.0, device=x.device)
+        )
+
+        total = l2_loss + self.auxk_alpha * auxk + decorr + jump_pen
+
+        if not logging:
+            return total
+        return namedtuple("LossLog", ["x", "x_hat", "f", "losses"])(
+            x, x_hat, z,
+            {
+                "l2_loss": l2_loss.item(),
+                "auxk_loss": float(auxk.item()),
+                "decorr_loss": float(decorr.item()),
+                "jump_penalty": float(jump_pen.item()),
+                "loss": total.item(),
+            },
+        )
+
+    def update(self, step: int, x: t.Tensor):
+        if step == 0:
+            self.ae.b_dec.data = geometric_median(x).to(self.ae.b_dec.dtype)
+
+        # Two-stage gate: freeze the poly branch during warm-up, unfreeze after.
+        in_warmup = step < self.dual_warmup_steps
+        for p in self.ae.poly.parameters():
+            p.requires_grad = not in_warmup
+
+        x = x.to(self.device)
+        total = self.loss(x, step=step)
+        total.backward()
+
+        # Keep mono decoder columns near unit norm via projected gradient.
+        self.ae.decoder.weight.grad = remove_gradient_parallel_to_decoder_directions(
+            self.ae.decoder.weight, self.ae.decoder.weight.grad,
+            self.ae.activation_dim, self.ae.dict_size,
+        )
+        t.nn.utils.clip_grad_norm_(self.ae.parameters(), 1.0)
+        self.optimizer.step()
+        self.optimizer.zero_grad()
+        self.scheduler.step()
+        self.ae.decoder.weight.data = set_decoder_norm_to_unit_norm(
+            self.ae.decoder.weight, self.ae.activation_dim, self.ae.dict_size
+        )
+        return total.item()
+
+    @property
+    def config(self):
+        return {
+            "trainer_class": "DualSAETrainer",
+            "dict_class": "DualSAE",
+            "sparsity_mode": self.sparsity_mode,
+            "lr": self.lr,
+            "steps": self.steps,
+            "k": int(self.ae.k.item()),
+            "poly_hidden": self.ae.poly_hidden,
+            "decorr_coef": self.decorr_coef,
+            "dual_warmup_steps": self.dual_warmup_steps,
+            "auxk_alpha": self.auxk_alpha,
+            "sparsity_penalty": self.sparsity_penalty,
+            "bandwidth": self.ae.bandwidth,
+            "warmup_steps": self.warmup_steps,
+            "decay_start": self.decay_start,
+            "seed": self.seed,
+            "activation_dim": self.ae.activation_dim,
+            "dict_size": self.ae.dict_size,
+            "device": self.device,
+            "layer": self.layer,
+            "lm_name": self.lm_name,
+            "wandb_name": self.wandb_name,
+            "submodule_name": self.submodule_name,
+        }
